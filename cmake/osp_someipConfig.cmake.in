@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/osp_someipTargets.cmake")

# newosp is a separate header-only dependency that this package does not
# install. Consumers either put newosp on their include path themselves, or
# set OSP_INCLUDE_DIR before find_package() so it is appended to the target.
if(DEFINED OSP_INCLUDE_DIR AND IS_DIRECTORY "${OSP_INCLUDE_DIR}")
    set_property(TARGET osp::osp_someip APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${OSP_INCLUDE_DIR}")
endif()

check_required_components(osp_someip)
